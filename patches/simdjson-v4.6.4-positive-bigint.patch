Subject: [PATCH] validate BigInt delimiters before exact-text preservation
Upstream-Base: simdjson v4.6.4
Upstream-Commit: 1bcf71bd85059ab6574ea1159de9298dcc1212c5

Official v4.6.4 returns through BIGINT_ERROR before parse_number reaches its
normal token-delimiter validation. Validate all three BigInt early-return
branches before preserving exact text so malformed suffixes cannot be dropped.
The positive 20-digit uint64-overflow branch remains routed through the existing
BIGINT_ERROR path for valid integer syntax such as 18446744073709551616.

The repeated hunks cover every architecture implementation generated into
simdjson's official singleheader source.

diff --git a/simdjson.cpp b/simdjson.cpp
--- a/simdjson.cpp
+++ b/simdjson.cpp
@@ -10870,3 +10870,6 @@
   size_t longest_digit_count = negative ? 19 : 20;
-  if (digit_count > longest_digit_count) { return BIGINT_NUMBER(src); }
+  if (digit_count > longest_digit_count) {
+    if (jsoncharutils::is_not_structural_or_whitespace(*p)) { return INVALID_NUMBER(src); }
+    return BIGINT_NUMBER(src);
+  }
   if (digit_count == longest_digit_count) {
@@ -10874,3 +10877,6 @@
       // Anything negative above INT64_MAX+1 is invalid
-      if (i > uint64_t(INT64_MAX)+1) { return BIGINT_NUMBER(src);  }
+      if (i > uint64_t(INT64_MAX)+1) {
+        if (jsoncharutils::is_not_structural_or_whitespace(*p)) { return INVALID_NUMBER(src); }
+        return BIGINT_NUMBER(src);
+      }
       WRITE_INTEGER(~i+1, src, writer);
@@ -10890,3 +10896,6 @@
     //
-    }  else if (src[0] != uint8_t('1') || i <= uint64_t(INT64_MAX)) { return INVALID_NUMBER(src); }
+    }  else if (src[0] != uint8_t('1') || i <= uint64_t(INT64_MAX)) {
+      if (jsoncharutils::is_not_structural_or_whitespace(*p)) { return INVALID_NUMBER(src); }
+      return BIGINT_NUMBER(src);
+    }
   }
